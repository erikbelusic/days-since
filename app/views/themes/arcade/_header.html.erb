<header class="border-b-2 border-border bg-[#07061a]">
  <nav class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-4 py-4 sm:px-6">
    <%= link_to root_path, class: "flex items-center gap-3 font-display leading-none" do %>
      <span class="text-[#ffe600]"><%= render "themes/arcade/pixel", sprite: "star", css_class: "h-6 w-7" %></span>
      <span>
        <span class="ar-glow block text-lg text-accent">DAYS-SINCE</span>
        <span class="mt-1.5 block text-[0.55rem] text-[#00e5ff]">HI-SCORE TABLE</span>
      </span>
    <% end %>

    <% if authenticated? %>
      <div class="flex flex-wrap items-center gap-4 font-display text-[0.6rem] uppercase [&_select]:rounded-none [&_select]:border-2 [&_select]:border-accent [&_select]:bg-[#07061a] [&_select]:font-body [&_select]:text-xs">
        <%= render "shared/theme_picker" %>
        <span class="hidden font-body text-xs normal-case text-ink-muted lg:inline"><%= Current.user.email_address %></span>
        <%= link_to "Settings", edit_settings_path, class: "text-[#00e5ff] hover:text-accent" %>
        <% unless SingleUserMode.enabled? %>
          <%= button_to "Sign out", session_path, method: :delete, class: "cursor-pointer text-[#00e5ff] uppercase hover:text-accent" %>
        <% end %>
      </div>
    <% end %>
  </nav>
</header>
