<%# Contribution-style grid of the last 28 days: weeks are columns, oldest left. %>
<%# Green = incident-free (darker once the streak passes a week), red = incident. %>
<%# locals: (activity:) %>
<% streak = 0 %>
<% cells = activity.map do |count|
     streak = count.zero? ? streak + 1 : 0
     if count >= 2 then "gh-cell-incident-many"
     elsif count == 1 then "gh-cell-incident"
     elsif streak > 7 then "gh-cell-clean-streak"
     else "gh-cell-clean"
     end
   end %>
<div class="grid shrink-0 grid-flow-col grid-rows-7 gap-[3px]" role="img"
     aria-label="<%= pluralize(activity.count(&:positive?), "day") %> with incidents in the last <%= activity.size %> days" data-activity-grid>
  <% cells.each_with_index do |css, index| %>
    <span class="gh-cell <%= css %>" title="<%= pluralize(activity[index], "incident") %>, <%= l(Current.user.zone.today - (activity.size - 1 - index), format: :short) %>"></span>
  <% end %>
</div>
