<%# locals: (subscription:, result:) %>
<% metric = "days_since{service:#{subscription.name.parameterize(separator: "_")}}" %>
<article id="<%= dom_id(subscription) %>" data-sortable-url="<%= subscription_position_path(subscription) %>" data-level="<%= result.level %>"
         class="dd-tile-edge <%= "ds-pulse" if result.ongoing? %> flex flex-col rounded-card border border-border bg-surface">
  <header class="flex items-center gap-2 px-3 pt-3 text-xs">
    <span data-sortable-handle class="cursor-grab select-none text-ink-muted" title="Drag to reorder" aria-hidden="true">⠿</span>
    <%= service_logo(subscription, css_class: "h-6 w-6 rounded", image_class: "bg-white p-0.5", monogram_class: "bg-[#383544] text-white text-xs") %>
    <h2 class="min-w-0 flex-1 truncate font-semibold text-sm">
      <%= link_to_if subscription.feed.site_url.present?, subscription.name, subscription.feed.site_url,
            class: "hover:text-accent hover:underline", target: "_blank", rel: "noopener", title: "Open the #{subscription.name} status page" %>
    </h2>
    <span class="dd-level-fill rounded-sm px-1.5 py-0.5 text-[0.65rem] font-bold uppercase tracking-wider" data-monitor-status data-level-label><%= stability_label(result.level) %></span>
    <%= link_to "Edit", edit_subscription_path(subscription), class: "text-ink-muted hover:text-accent hover:underline", aria: { label: "Edit #{subscription.name}" } %>
  </header>
  <p class="dd-mono truncate px-3 pt-1 text-[0.7rem] text-ink-muted" title="<%= metric %>"><%= metric %></p>

  <div class="mx-3 mt-3 flex items-baseline gap-2 rounded-sm px-3 py-2 <%= result.ongoing? ? "dd-level-fill" : "dd-level-tint" %>">
    <p class="text-6xl font-light tabular-nums leading-none" data-days><%= result.waiting? ? "–" : result.infinite? ? "∞" : result.days %></p>
    <p class="text-sm opacity-80"><%= result.waiting? ? "no data yet" : result.infinite? ? "days" : "day".pluralize(result.days) %><%= " · incident active" if result.ongoing? %></p>
  </div>

  <div class="px-3 pt-4">
    <%# Timeseries: taller and hotter bars for worse days; no bar before tracking. %>
    <%= render "themes/default/day_strip", result: result, css_class: "dd-gridline h-14 items-end gap-[2px] border-b border-border", day_class: "dd-bar rounded-t-[1px]" %>
    <div class="dd-mono flex justify-between pt-1 text-[0.65rem] text-ink-muted"><span>-<%= result.activity.size %>d</span><span>now</span></div>
  </div>

  <footer class="mt-auto space-y-0.5 border-t border-border px-3 py-2 text-xs text-ink-muted">
    <% if result.incident %>
      <p class="flex items-baseline gap-2">
        <span class="dd-mono shrink-0 <%= result.ongoing? ? "text-danger" : "text-ok" %>"><%= result.ongoing? ? "TRIGGERED" : "RESOLVED" %></span>
        <span class="min-w-0 flex-1 truncate">
          <%= link_to_if result.incident.url.present?, result.incident.title, result.incident.url, class: "text-ink hover:text-accent hover:underline", target: "_blank", rel: "noopener" %>
        </span>
        <span class="dd-mono shrink-0"><%= result.ongoing? ? "now" : l(result.incident.started_at.in_time_zone(Current.user.zone).to_date, format: "%b %-d") %></span>
      </p>
    <% end %>
    <% if result.ignored_count.positive? %>
      <p class="truncate" title="<%= threshold_explanation(result) %>"><%= ignored_incidents_note(result) %></p>
    <% end %>
    <% if subscription.feed.failing? %>
      <p class="truncate text-danger" title="<%= subscription.feed.last_error %>">Check failing: <%= subscription.feed.last_error %></p>
    <% elsif subscription.feed.last_success_at.nil? %>
      <p>Waiting for first data…</p>
    <% end %>
  </footer>
</article>
