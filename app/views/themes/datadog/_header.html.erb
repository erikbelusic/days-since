<header class="dd-nav text-white">
  <nav class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-4 py-2.5 sm:px-6">
    <%= link_to root_path, class: "flex items-center gap-2.5 font-semibold tracking-wide" do %>
      <svg class="h-6 w-6" viewBox="0 0 24 24" aria-hidden="true">
        <rect x="3" y="12" width="3.5" height="9" rx="0.5" fill="#fff" opacity="0.6"/>
        <rect x="8.5" y="7" width="3.5" height="14" rx="0.5" fill="#fff" opacity="0.8"/>
        <rect x="14" y="3" width="3.5" height="18" rx="0.5" fill="#fff"/>
        <path d="M2 21.5h20" stroke="#fff" stroke-width="1.5"/>
      </svg>
      <span>days-since <span class="font-normal text-white/70">/ Incident Dashboard</span></span>
    <% end %>

    <% if authenticated? %>
      <div class="flex flex-wrap items-center gap-4 text-sm [&_select]:border-white/40 [&_select]:bg-[#4e2287] [&_select]:text-white [&_label]:text-white/75">
        <%= render "shared/theme_picker" %>
        <span class="hidden text-white/70 lg:inline"><%= Current.user.email_address %></span>
        <%= link_to "Settings", edit_settings_path, class: "hover:underline" %>
        <% unless SingleUserMode.enabled? %>
          <%= button_to "Sign out", session_path, method: :delete, class: "cursor-pointer rounded border border-white/40 px-3 py-1 hover:bg-white/10" %>
        <% end %>
      </div>
    <% end %>
  </nav>
</header>
