<%# locals: (subscription:, result:) %>
<%# A Swiss poster: a flat field in the level color with a giant cropped number, %>
<%# then a white panel with the facts. %>
<article id="<%= dom_id(subscription) %>" data-sortable-url="<%= subscription_position_path(subscription) %>" data-level="<%= result.level %>"
         class="<%= "ds-pulse" if result.ongoing? %> flex flex-col bg-surface">
  <div class="sw-field relative h-60 overflow-hidden bg-level text-white">
    <header class="relative z-10 flex items-center gap-2 px-4 pt-3">
      <span data-sortable-handle class="cursor-grab select-none text-white/70" title="Drag to reorder" aria-hidden="true">⠿</span>
      <%= service_logo(subscription, css_class: "h-5 w-5", image_class: "bg-white p-0.5 grayscale contrast-125", monogram_class: "bg-white text-ink text-[0.6rem]") %>
      <h2 class="min-w-0 flex-1 truncate text-base font-bold">
        <%= link_to_if subscription.feed.site_url.present?, subscription.name, subscription.feed.site_url,
              class: "hover:underline", target: "_blank", rel: "noopener", title: "Open the #{subscription.name} status page" %>
      </h2>
      <%= link_to "Edit", edit_subscription_path(subscription), class: "sw-caps text-[0.65rem] text-white/80 hover:text-white", aria: { label: "Edit #{subscription.name}" } %>
    </header>
    <p class="sw-tight absolute -bottom-[0.05em] -left-[0.05em] text-[10rem] font-bold leading-[0.8] tabular-nums" data-days>
      <%= result.infinite? ? "∞" : result.days %>
    </p>
  </div>

  <div class="flex flex-1 flex-col border-x border-b border-ink px-4 pt-3 pb-3">
    <div class="flex items-baseline justify-between gap-3">
      <p class="sw-caps text-[0.7rem] font-bold" data-level-label><%= stability_label(result.level) %></p>
      <p class="text-xs text-ink-muted">
        <% if result.ongoing? %>Incident in progress
        <% elsif result.infinite? %>No incidents on record
        <% elsif result.no_history? %><%= "Day".pluralize(result.days) %> since tracking began
        <% else %><%= "Day".pluralize(result.days) %> without an incident<% end %>
      </p>
    </div>

    <footer class="mt-3 space-y-1 border-t border-ink pt-2 text-xs text-ink-muted">
      <% if result.incident %>
        <p class="flex gap-3">
          <span class="shrink-0 font-bold text-ink tabular-nums"><%= (result.incident.resolved_at || result.incident.started_at).in_time_zone(Current.user.zone).to_date.iso8601 %></span>
          <span class="min-w-0 truncate"><%= link_to_if result.incident.url.present?, result.incident.title, result.incident.url, class: "text-ink hover:text-accent", target: "_blank", rel: "noopener" %></span>
        </p>
      <% end %>
      <% if result.ignored_count.positive? %>
        <p class="truncate" title="<%= threshold_explanation(result) %>"><%= ignored_incidents_note(result) %></p>
      <% end %>
      <% if subscription.feed.failing? %>
        <p class="truncate text-accent" title="<%= subscription.feed.last_error %>">Source unreachable: <%= subscription.feed.last_error %></p>
      <% elsif subscription.feed.last_success_at.nil? %>
        <p>Awaiting first report</p>
      <% end %>
    </footer>
  </div>
</article>
