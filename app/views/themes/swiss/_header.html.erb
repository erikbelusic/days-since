<header class="border-b-4 border-ink bg-surface">
  <nav class="mx-auto flex max-w-6xl flex-wrap items-end justify-between gap-4 px-4 pt-5 pb-3 sm:px-6">
    <%= link_to root_path, class: "flex items-end gap-3 leading-none" do %>
      <span class="h-10 w-10 bg-accent" aria-hidden="true"></span>
      <span>
      <span class="block text-2xl font-bold sw-tight">days-since</span>
      <span class="sw-caps mt-1 block text-[0.65rem] text-ink-muted">Incident report</span>
      </span>
    <% end %>

    <% if authenticated? %>
      <div class="sw-caps flex flex-wrap items-center gap-5 text-[0.7rem] [&_select]:rounded-none [&_select]:border-ink [&_select]:normal-case [&_select]:tracking-normal">
        <%= render "shared/theme_picker" %>
        <span class="hidden text-ink-muted lg:inline normal-case tracking-normal"><%= Current.user.email_address %></span>
        <%= link_to "Settings", edit_settings_path, class: "hover:text-accent" %>
        <% unless SingleUserMode.enabled? %>
          <%= button_to "Sign out", session_path, method: :delete, class: "sw-caps cursor-pointer hover:text-accent" %>
        <% end %>
      </div>
    <% end %>
  </nav>
</header>
