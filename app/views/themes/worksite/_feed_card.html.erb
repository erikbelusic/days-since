<%# locals: (subscription:, result:) %>
<% sign_style = { "waiting" => "bg-[#6b7280] text-white", "ongoing" => "bg-[#c62828] text-white", "day_one" => "bg-[#e8590c] text-[#111]", "short_streak" => "bg-[#111] text-[#f5c400]",
                   "long_streak" => "bg-[#1e7a34] text-white", "solid_streak" => "bg-[#1e7a34] text-white" }.fetch(result.level) %>
<article id="<%= dom_id(subscription) %>" data-sortable-url="<%= subscription_position_path(subscription) %>" data-level="<%= result.level %>"
         class="<%= result.ongoing? ? "ws-hazard-red ds-pulse" : "ws-hazard" %> flex flex-col rounded-card p-4 shadow-[0_6px_0_rgb(0_0_0/0.35)]">
  <div class="relative flex flex-1 flex-col bg-surface px-5 pt-4 pb-3 text-ink">
    <p class="-mx-5 -mt-4 mb-3 border-b-4 border-[#111] py-1 text-center font-display text-3xl leading-none tracking-[0.15em] uppercase <%= sign_style %>" data-level-label><%= stability_label(result.level) %></p>
    <span class="ws-bolt absolute top-2 left-2 h-2.5 w-2.5 rounded-full" aria-hidden="true"></span>
    <span class="ws-bolt absolute top-2 right-2 h-2.5 w-2.5 rounded-full" aria-hidden="true"></span>

    <header class="grid grid-cols-[3rem_minmax(0,1fr)_3rem] items-center gap-2 px-2">
      <span data-sortable-handle class="cursor-grab select-none justify-self-start text-ink-muted" title="Drag to reorder" aria-hidden="true">⠿</span>
      <h2 class="flex min-w-0 items-center justify-center gap-2 font-display text-2xl leading-none tracking-wider">
        <%= service_logo(subscription, css_class: "h-7 w-7 rounded-sm border-2 border-[#111]", image_class: "bg-white p-0.5", monogram_class: "bg-white text-[#111] text-lg") %>
        <span class="min-w-0 truncate"><%= link_to_if subscription.feed.site_url.present?, subscription.name, subscription.feed.site_url,
              class: "hover:underline underline-offset-2", target: "_blank", rel: "noopener", title: "Open the #{subscription.name} status page" %></span>
      </h2>
      <%= link_to "Edit", edit_subscription_path(subscription), class: "justify-self-end font-body text-xs uppercase tracking-wide text-ink-muted hover:text-ink hover:underline", aria: { label: "Edit #{subscription.name}" } %>
    </header>

    <div class="ws-panel mx-auto mt-3 flex w-full items-center justify-center rounded-lg py-2">
      <p class="font-display text-8xl leading-none tabular-nums <%= result.ongoing? ? "text-danger" : "text-ink" %>" data-days>
        <%= result.waiting? ? "--" : result.infinite? ? "∞" : result.days.to_s.rjust(2, "0") %>
      </p>
    </div>

    <% if result.ongoing? %>
      <p class="mt-3 flex items-center justify-center gap-2 bg-danger px-2 py-1 font-display text-2xl leading-none tracking-wider text-white">
        <%= render "themes/worksite/warning_sign", css_class: "h-6 w-6" %> Incident in progress
      </p>
    <% end %>

    <p class="mt-3 text-center font-display text-4xl leading-[0.9] tracking-wide">
      <% if result.waiting? %>
        <span class="block">Awaiting first</span> <span class="block">inspection</span>
      <% elsif result.no_history? && result.infinite? %>
        <span class="block">No incidents</span> <span class="block">on record</span>
      <% elsif result.no_history? %>
        <span class="block">Days since</span> <span class="block">tracking started</span>
      <% else %>
        <span class="block">Days since</span> <span class="block">last incident</span>
      <% end %>
    </p>

    <footer class="mt-auto space-y-0.5 pt-3 text-xs uppercase tracking-wide text-ink-muted">
      <% if result.incident %>
        <p class="truncate">
          <%= result.ongoing? ? "Current:" : "Last:" %>
          <%= link_to_if result.incident.url.present?, result.incident.title, result.incident.url, class: "text-ink hover:underline", target: "_blank", rel: "noopener" %>
        </p>
      <% end %>
      <% if result.ignored_count.positive? %>
        <p class="truncate" title="<%= threshold_explanation(result) %>"><%= ignored_incidents_note(result) %></p>
      <% end %>
      <% if subscription.feed.failing? %>
        <p class="truncate text-danger" title="<%= subscription.feed.last_error %>">Status page unreachable: <%= subscription.feed.last_error %></p>
      <% elsif subscription.feed.last_success_at.nil? %>
        <p>Awaiting first inspection…</p>
      <% end %>
    </footer>
  </div>
</article>
