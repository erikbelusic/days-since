<header class="fh-header fh-wood">
  <nav class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <%= link_to root_path, class: "fh-ink rounded-sm bg-[#fbfaf7]/90 px-3 pt-1.5 pb-1 font-display text-3xl leading-none tracking-wide shadow-sm hover:bg-[#fbfaf7]" do %>
      Days Since
    <% end %>

    <% if authenticated? %>
      <div class="flex flex-wrap items-center gap-4 rounded-sm bg-[#fbfaf7]/90 px-3 py-1.5 text-sm text-[#1d1a17] shadow-sm [&_select]:border-[#5a4636]/50 [&_select]:bg-[#fbfaf7] [&_select]:text-[#1d1a17] [&_label]:text-[#5a4636]">
        <%= render "shared/theme_picker" %>
        <span class="hidden text-[#5a4636] lg:inline"><%= Current.user.email_address %></span>
        <%= link_to "Settings", edit_settings_path, class: "font-semibold hover:underline" %>
        <% unless SingleUserMode.enabled? %>
          <%= button_to "Sign out", session_path, method: :delete, class: "cursor-pointer rounded border border-[#5a4636]/50 px-3 py-1 hover:bg-[#5a4636] hover:text-[#fbfaf7]" %>
        <% end %>
      </div>
    <% end %>
  </nav>
</header>
