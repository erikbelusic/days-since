<%# locals: (subscription:, result:) %>
<% digits = result.waiting? ? %w[ – – – ] : result.infinite? ? [ "∞" ] : result.days.to_s.rjust(3, "0").chars %>
<article id="<%= dom_id(subscription) %>" data-sortable-url="<%= subscription_position_path(subscription) %>" data-level="<%= result.level %>"
         class="fh-wood <%= "ds-pulse" if result.ongoing? %> flex flex-col rounded-card px-6 pt-4 pb-4">
  <header class="grid grid-cols-[3rem_minmax(0,1fr)_3rem] items-center gap-2 font-body text-xs text-[#1d1a17]">
    <span data-sortable-handle class="cursor-grab select-none justify-self-start" title="Drag to reorder" aria-hidden="true">⠿</span>
    <h2 class="flex min-w-0 max-w-full items-center justify-self-center gap-1.5 rounded-sm bg-[#fbfaf7]/80 px-2 py-0.5 font-body text-base font-bold tracking-wide shadow-sm">
      <%= service_logo(subscription, css_class: "h-5 w-5 rounded-sm", image_class: "mix-blend-multiply grayscale brightness-[.6] contrast-[1.8] sepia-[.35]", monogram_class: "bg-[#5a4636] text-[#fbfaf7] text-xs") %>
      <span class="min-w-0 truncate"><%= link_to_if subscription.feed.site_url.present?, subscription.name, subscription.feed.site_url,
            class: "hover:underline underline-offset-2", target: "_blank", rel: "noopener", title: "Open the #{subscription.name} status page" %></span>
    </h2>
    <%= link_to "Edit", edit_subscription_path(subscription), class: "justify-self-end rounded-sm bg-[#fbfaf7]/70 px-1.5 hover:underline", aria: { label: "Edit #{subscription.name}" } %>
  </header>

  <p class="mt-3 text-center"><span class="fh-ribbon bg-level px-5 py-1 font-body text-xs font-bold uppercase tracking-[0.15em] text-[#fbfaf7]" data-level-label><%= stability_label(result.level) %></span></p>

  <div class="mt-4 flex justify-center gap-3" data-days aria-label="<%= result.waiting? ? "No data yet" : "#{result.infinite? ? "infinite" : result.days} days" %>">
    <% digits.each do |digit| %>
      <span class="fh-flip <%= "fh-flip-ongoing" if result.ongoing? %> flex h-24 w-16 items-center justify-center pt-3 text-6xl leading-none" aria-hidden="true"><%= digit %></span>
    <% end %>
  </div>

  <p class="fh-ink mt-3 text-center font-display text-[1.7rem] leading-none uppercase <%= "text-[#7d1f1a]" if result.ongoing? %>">
    <% if result.ongoing? %>Incident in progress
    <% elsif result.waiting? %>No news yet
    <% elsif result.no_history? && result.infinite? %>No incidents on record
    <% elsif result.no_history? %>Days since we started
    <% else %>Days since last incident<% end %>
  </p>

  <%# The fence: one painted picket per day for the last 28 days. %>
  <div class="mt-4">
    <%= render "themes/default/day_strip", result: result, css_class: "h-7 gap-[3px]", day_class: "fh-picket" %>
    <div class="fh-rail h-1.5 rounded-[1px]" aria-hidden="true"></div>
    <div class="mt-1 flex justify-between font-body text-xs font-semibold text-[#2b2724] [text-shadow:0_1px_0_rgb(255_255_255/0.6)]"><span>Four weeks back</span><span>Today</span></div>
  </div>

  <% if result.incident || result.ignored_count.positive? || subscription.feed.failing? || subscription.feed.last_success_at.nil? %>
    <footer class="mt-auto pt-3">
      <div class="space-y-0.5 rounded-sm bg-[#fbfaf7]/90 px-2.5 py-1.5 font-body text-sm text-[#1d1a17] shadow-sm">
        <% if result.incident %>
          <p class="flex items-baseline gap-3">
            <span class="min-w-0 flex-1 truncate">
              <%= link_to_if result.incident.url.present?, result.incident.title, result.incident.url, class: "font-semibold hover:underline", target: "_blank", rel: "noopener" %>
            </span>
            <span class="shrink-0 tabular-nums text-[#6b6359]"><%= result.ongoing? ? "Now" : l(result.incident.started_at.in_time_zone(Current.user.zone).to_date, format: "%b %-d") %></span>
          </p>
        <% end %>
        <% if result.ignored_count.positive? %>
          <p class="truncate text-xs" title="<%= threshold_explanation(result) %>"><%= ignored_incidents_note(result) %></p>
        <% end %>
        <% if subscription.feed.failing? %>
          <p class="truncate text-xs text-[#962f2a]" title="<%= subscription.feed.last_error %>">Can't reach the status page: <%= subscription.feed.last_error %></p>
        <% elsif subscription.feed.last_success_at.nil? %>
          <p class="text-xs">Waiting on the first update…</p>
        <% end %>
      </div>
    </footer>
  <% end %>
</article>
