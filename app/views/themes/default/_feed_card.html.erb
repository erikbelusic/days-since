<%# locals: (subscription:, result:) %>
<article id="<%= dom_id(subscription) %>" data-sortable-url="<%= subscription_position_path(subscription) %>" data-level="<%= result.level %>"
         class="relative flex flex-col overflow-hidden rounded-card bg-surface p-5 <%= result.ongoing? ? "ds-pulse border-2 border-level pt-7" : "border border-border" %>">
  <% if result.ongoing? %>
    <%# A band across the top marks a live incident without tinting the whole card. %>
    <span class="absolute inset-x-0 top-0 h-2 bg-level" aria-hidden="true"></span>
  <% end %>
  <header class="flex items-center gap-2.5">
    <span data-sortable-handle class="cursor-grab select-none text-ink-muted" title="Drag to reorder" aria-hidden="true">⠿</span>
    <%= service_logo(subscription, css_class: "h-7 w-7 rounded-lg", image_class: "bg-white p-0.5 ring-1 ring-border", monogram_class: "bg-surface-muted text-ink-muted text-xs") %>
    <h2 class="min-w-0 flex-1 truncate font-display text-lg font-semibold tracking-tight">
      <%= link_to_if subscription.feed.site_url.present?, subscription.name, subscription.feed.site_url,
            class: "hover:underline underline-offset-2", target: "_blank", rel: "noopener", title: "Open the #{subscription.name} status page" %>
    </h2>
    <%= link_to "Edit", edit_subscription_path(subscription), class: "text-sm text-ink-muted hover:text-ink hover:underline", aria: { label: "Edit #{subscription.name}" } %>
  </header>

  <div class="mt-6 flex items-end justify-between gap-3">
    <p class="df-count font-numeric text-8xl font-bold tabular-nums text-level" data-days>
      <%= result.waiting? ? "–" : result.infinite? ? "∞" : result.days %>
    </p>
    <p class="mb-1 flex items-center gap-1.5 text-sm font-semibold text-level">
      <span class="h-2 w-2 rounded-full bg-level" aria-hidden="true"></span>
      <span data-level-label><%= stability_label(result.level) %></span>
    </p>
  </div>
  <p class="mt-2 text-sm text-ink-muted"><%= counter_caption(result).upcase_first %></p>

  <div class="mt-5">
    <%= render "themes/default/day_strip", result: result, css_class: "h-7 gap-[3px]", day_class: "rounded-full" %>
    <div class="mt-1.5 flex justify-between text-xs text-ink-muted"><span>4 weeks ago</span><span>Today</span></div>
  </div>

  <footer class="mt-auto space-y-1 pt-4 text-sm text-ink-muted">
    <% if result.incident %>
      <p class="flex items-baseline gap-3 border-t border-border pt-3">
        <span class="min-w-0 flex-1 truncate">
          <%= link_to_if result.incident.url.present?, result.incident.title, result.incident.url, class: "text-ink underline-offset-2 hover:underline", target: "_blank", rel: "noopener" %>
        </span>
        <span class="shrink-0 tabular-nums"><%= result.ongoing? ? "Now" : l(result.incident.started_at.in_time_zone(Current.user.zone).to_date, format: "%b %-d") %></span>
      </p>
    <% end %>
    <% if result.ignored_count.positive? %>
      <p title="<%= threshold_explanation(result) %>"><%= ignored_incidents_note(result) %></p>
    <% end %>
    <% if subscription.feed.failing? %>
      <p class="text-danger" title="<%= subscription.feed.last_error %>">Can't reach this status page right now (last error: <%= subscription.feed.last_error %>)</p>
    <% elsif subscription.feed.last_success_at.nil? %>
      <p>Waiting for the first update…</p>
    <% end %>
  </footer>
</article>
