<%# locals: (subscription:, result:) %>
<article id="<%= dom_id(subscription) %>" data-sortable-url="<%= subscription_position_path(subscription) %>" data-level="<%= result.level %>"
         class="flex flex-col rounded-card border border-l-4 border-border border-l-level p-5 shadow-sm <%= result.ongoing? ? "ds-pulse border-level bg-danger-surface" : "bg-surface" %>">
  <header class="flex items-start justify-between gap-3">
    <div class="flex min-w-0 items-start gap-2">
      <span data-sortable-handle class="mt-0.5 cursor-grab select-none text-ink-muted" title="Drag to reorder" aria-hidden="true">⠿</span>
      <%= service_logo(subscription, css_class: "h-6 w-6 rounded-md", monogram_class: "bg-surface-muted text-ink-muted text-xs") %>
      <h2 class="font-display text-lg font-semibold leading-tight">
        <%= link_to_if subscription.feed.site_url.present?, subscription.name, subscription.feed.site_url,
              class: "hover:underline underline-offset-2", target: "_blank", rel: "noopener", title: "Open the #{subscription.name} status page" %>
      </h2>
    </div>
    <div class="flex shrink-0 items-center gap-2">
      <span class="rounded-full px-2.5 py-0.5 text-xs font-bold uppercase tracking-wide <%= result.ongoing? ? "bg-level text-surface" : "border border-level text-level" %>" data-level-label><%= stability_label(result.level) %></span>
      <%= link_to "Edit", edit_subscription_path(subscription), class: "text-sm text-ink-muted hover:text-ink hover:underline", aria: { label: "Edit #{subscription.name}" } %>
    </div>
  </header>

  <div class="my-6 text-center">
    <p class="font-numeric text-7xl font-bold tabular-nums text-level" data-days>
      <%= result.infinite? ? "∞" : result.days %>
    </p>
    <p class="mt-1 text-sm text-ink-muted"><%= counter_caption(result) %></p>
  </div>

  <footer class="mt-auto space-y-1 border-t border-border pt-3 text-sm text-ink-muted">
    <% if result.incident %>
      <p class="truncate">
        <%= result.ongoing? ? "Current:" : "Last:" %>
        <%= link_to_if result.incident.url.present?, result.incident.title, result.incident.url, class: "text-ink underline-offset-2 hover:underline", target: "_blank", rel: "noopener" %>
      </p>
    <% end %>
    <% if result.ignored_count.positive? %>
      <p title="<%= threshold_explanation(result) %>"><%= ignored_incidents_note(result) %></p>
    <% end %>
    <% if subscription.feed.failing? %>
      <p class="text-danger" title="<%= subscription.feed.last_error %>">Can't reach this status page right now (last error: <%= subscription.feed.last_error %>)</p>
    <% elsif subscription.feed.last_success_at.nil? %>
      <p>Waiting for the first update…</p>
    <% end %>
  </footer>
</article>
