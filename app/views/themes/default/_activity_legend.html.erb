<%# Explains the colors of the 28-day strip on each card. Unknown severity only
    appears when an RSS feed (which has no severity) actually shows one. %>
<%# locals: (results:) %>
<% unknown = results.any? { |result| result.worst_impacts.include?("unknown") } %>
<ul class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-ink-muted" aria-label="Day colors in the last 28 days" data-activity-legend>
  <% { "untracked" => "Not tracked yet", "clear" => "No incidents", "minor" => "Minor", ("unknown" if unknown) => "Severity unknown",
       "major" => "Major", "critical" => "Critical" }.except(nil).each do |day, label| %>
    <li class="flex items-center gap-1.5"><span class="ds-day inline-block h-3.5 w-1.5 rounded-full" data-day="<%= day %>" aria-hidden="true"></span><%= label %></li>
  <% end %>
</ul>
