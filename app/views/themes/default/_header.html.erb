<header class="border-b border-border bg-surface">
  <nav class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-4 py-4 sm:px-6">
    <%= link_to root_path, class: "flex items-center gap-2.5 font-display text-xl font-bold tracking-tight" do %>
      <%# A tally mark: four days and the slash that closes the week's count. %>
      <svg viewBox="0 0 28 24" class="h-6 w-7 text-accent" aria-hidden="true">
        <g stroke="currentColor" stroke-width="2.6" stroke-linecap="round">
          <line x1="5" y1="3" x2="5" y2="21"/><line x1="10.5" y1="3" x2="10.5" y2="21"/>
          <line x1="16" y1="3" x2="16" y2="21"/><line x1="21.5" y1="3" x2="21.5" y2="21"/>
          <line x1="2" y1="17" x2="25" y2="7"/>
        </g>
      </svg>
      <span>days-since</span>
    <% end %>

    <% if authenticated? %>
      <div class="flex flex-wrap items-center gap-4 text-sm">
        <%= render "shared/theme_picker" %>
        <span class="hidden text-ink-muted lg:inline"><%= Current.user.email_address %></span>
        <%= link_to "Settings", edit_settings_path, class: "hover:underline" %>
        <% unless SingleUserMode.enabled? %>
          <%= button_to "Sign out", session_path, method: :delete, class: "cursor-pointer rounded-md border border-border px-3 py-1.5 hover:bg-surface-muted" %>
        <% end %>
      </div>
    <% end %>
  </nav>
</header>
