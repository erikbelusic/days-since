<% if notice.present? %>
  <p id="notice" class="mb-6 rounded-card border border-border bg-surface-muted px-4 py-3 font-medium text-ok"><%= notice %></p>
<% end %>
<% if alert.present? %>
  <p id="alert" role="alert" class="mb-6 rounded-card border border-danger bg-danger-surface px-4 py-3 font-medium text-danger"><%= alert %></p>
<% end %>
