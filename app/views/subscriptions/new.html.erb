<% content_for :title, "Add a status page · days-since" %>

<div class="mx-auto max-w-xl">
  <h1 class="font-display text-3xl font-bold">Add a status page</h1>
  <p class="mt-2 text-ink-muted">Paste a status page or feed URL. Atlassian Statuspage sites (like githubstatus.com) and RSS/Atom feeds both work.</p>

  <%= form_with model: @form, url: subscriptions_path, class: "mt-6 space-y-5 rounded-card border border-border bg-surface p-6" do |form| %>
    <% if @form.errors.any? %>
      <div id="form_errors" role="alert" class="rounded-md border border-danger bg-danger-surface px-4 py-3 text-danger">
        <% @form.errors.full_messages.each do |message| %>
          <p><%= message %></p>
        <% end %>
      </div>
    <% end %>

    <div>
      <%= form.label :url, "Status page URL", class: "block font-medium" %>
      <%= form.text_field :url, required: true, autofocus: true, placeholder: "githubstatus.com", autocomplete: "off",
            class: "mt-2 block w-full rounded-md border border-border bg-surface px-3 py-2 shadow-sm focus:outline-accent" %>
    </div>

    <div>
      <%= form.label :display_name, "Name (optional)", class: "block font-medium" %>
      <%= form.text_field :display_name, placeholder: "Defaults to the status page's name",
            class: "mt-2 block w-full rounded-md border border-border bg-surface px-3 py-2 shadow-sm focus:outline-accent" %>
    </div>

    <details class="text-sm" <%= "open" if @form.provider.present? %>>
      <summary class="cursor-pointer text-ink-muted">Advanced: choose the provider</summary>
      <div class="mt-3">
        <%= form.label :provider, "Provider", class: "block font-medium" %>
        <%= form.select :provider, SubscriptionForm::PROVIDER_OPTIONS, {}, class: "mt-2 block w-full rounded-md border border-border bg-surface px-3 py-2" %>
        <p class="mt-1 text-ink-muted">Use this if detection picks the wrong source, for example to follow a Statuspage site's RSS feed instead.</p>
      </div>
    </details>

    <div class="flex items-center gap-4">
      <%= form.submit "Add status page", class: "cursor-pointer rounded-md bg-accent px-4 py-2.5 font-medium text-accent-ink hover:opacity-90" %>
      <%= link_to "Cancel", root_path, class: "text-ink-muted hover:underline" %>
    </div>
  <% end %>
</div>
